# Copy this to .env
PORT=3000

# باسورد لوحة التحكم (مهم قبل الإنتاج)
DASHBOARD_PASSWORD=PASTE_HERE
# أدوار إضافية (اختياري — تُنشأ كمستخدمين عند أول تشغيل، وتُدار بعدها من تبويب المستخدمين)
# STAFF_PASSWORD=PASTE_HERE
# DOCTOR_PASSWORD=PASTE_HERE
# مالك المنصة (Multi-tenant — إدارة العيادات والاشتراكات من /super.html)
# SUPERADMIN_PASSWORD=PASTE_HERE
# تشفير النسخ الاحتياطية (64 hex — ولّد بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# BACKUP_KEY=PASTE_HERE
# سياسة الاحتفاظ بالرسائل بالأيام (افتراضي 365)
# RETENTION_DAYS=365

# WhatsApp Cloud API (from developers.facebook.com)
WHATSAPP_TOKEN=PASTE_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_HERE
VERIFY_TOKEN=mohamed123
# قالب التذكير المعتمد (اختياري — إلزامي لو الرسالة بعد 24 ساعة)
# WHATSAPP_REMINDER_TEMPLATE=reminder_1
# WHATSAPP_TEMPLATE_LANG=ar_EG

# إشعار الاستقبال عند طلب بشري (موبايل الاستقبال)
# STAFF_NOTIFY_PHONE=01xxxxxxxxx
# نسخة احتياطية خارجية (اختياري): رابط webhook يستقبل الملف
# BACKUP_WEBHOOK_URL=https://example.com/upload
# متابعة الغايبين كل كام يوم (افتراضي 180)
# RECALL_DAYS=180

# OpenAI (مدفوع) — من https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_HERE
OPENAI_MODEL=gpt-4o-mini
# بديل مجاني (اختياري): Google Gemini — من https://aistudio.google.com/apikey
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash

# Business (default client for MVP)
BUSINESS_NAME=عيادة د. أحمد للأسنان
